# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nexus
DB_SSL=false

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=7d

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=nexus-documents

# ── FastAPI Agent Core ───────────────────────────────────────────────────────
AGENT_CORE_URL=http://localhost:8000

# ── Encryption (for tool headers that may contain API keys) ──────────────────
ENCRYPTION_KEY=32_char_hex_key_change_in_prod!!
WIDGET_JWT_SECRET="change_me_too"